# =========================================================================
# proxmox.env.example — ШАБЛОН (placeholder'ы, БЕЗ реального секрета).
#
# Как использовать:
#   1. cp Security/proxmox.env.example Security/proxmox.env
#   2. Вписать РЕАЛЬНЫЕ значения токена в Security/proxmox.env
#      (этот файл в .gitignore — в репозиторий не попадёт).
#   3. Экспорт в текущую сессию shell:
#        set -a; source Security/proxmox.env; set +a
#      (или построчно: export PM_API_TOKEN_SECRET='<secret>')
#   4. Проверка, что переменные видны (значение не печатаем целиком!):
#        env | grep -E '^PM_' | sed 's/=\(.\{4\}\).*/=\1****/'
#   5. Далее: cd Terraform && terraform init && terraform plan
#
# ВАЖНО:
#   - Никогда не хардкодить токен в *.tf, *.tfvars, README или коммиты.
#   - Terraform-провайдер bpg/proxmox читает именно эти PM_* переменные.
#   - PM_TLS_INSECURE=true обязателен: API Proxmox на самоподписанном сертификате.
# =========================================================================

# URL API Proxmox VE (схема + host + порт, без /api2/json — провайдер добавит сам)
PM_API_URL="https://192.168.1.253:8006/"

# ID токена в формате <realm-user>!<token-name>
PM_API_TOKEN_ID="root@pam!terraform"

# СЕКРЕТ ТОКЕНА — заменить на реальный (36 символов UUID). В git НЕ коммитить.
PM_API_TOKEN_SECRET="REPLACE_WITH_REAL_TOKEN_SECRET"

# Принимать самоподписанный сертификат API Proxmox
PM_TLS_INSECURE="true"

# ---------------------------------------------------------------------------
# Дополнительно (не секрет, удобно держать рядом) — целевой узел/хранилище/мост.
# Agent 2 (Terraform) ОБЯЗАН подтвердить их через Proxmox API (решение D6):
#   curl -sk -H "Authorization: PVEAPIToken=${PM_API_TOKEN_ID}=${PM_API_TOKEN_SECRET}" \
#        "${PM_API_URL}api2/json/nodes" | jq '.data[].node'
#   curl -sk -H "Authorization: PVEAPIToken=${PM_API_TOKEN_ID}=${PM_API_TOKEN_SECRET}" \
#        "${PM_API_URL}api2/json/nodes/<NODE>/storage" | jq '.data[].storage'
#   curl -sk -H "Authorization: PVEAPIToken=${PM_API_TOKEN_ID}=${PM_API_TOKEN_SECRET}" \
#        "${PM_API_URL}api2/json/nodes/<NODE>/network" | jq '.data[] | select(.type=="bridge") | .iface'
# ---------------------------------------------------------------------------
PM_NODE="REPLACE_WITH_NODE_NAME"        # например pve
PM_STORAGE="REPLACE_WITH_STORAGE_ID"    # например local-lvm
PM_BRIDGE="REPLACE_WITH_BRIDGE"         # например vmbr0
PM_GATEWAY="192.168.1.1"                # подтвердить связностью (D6)
PM_DNS_1="192.168.1.1"
PM_DNS_2="8.8.8.8"
PM_NETMASK="24"
