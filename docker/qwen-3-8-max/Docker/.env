# ============================================================================
# Общие переменные окружения event-driven проекта (контракт INFRA-агента).
# Файл читается docker compose автоматически (лежит рядом с compose-файлами).
# Все compose-файлы кластеров (kafka/rabbitmq/redis) и сервиса обязаны
# использовать ИМЕННО ЭТИ имена переменных.
# ============================================================================

# Имя compose-проекта (префикс имён контейнеров/сетей)
COMPOSE_PROJECT_NAME=event-driven

# Имя общей docker-сети (bridge). Создаётся INFRA-агентом:
#   docker network create event-driven-net
# Кластерные compose-файлы подключаются к ней как external: true.
NETWORK_NAME=event-driven-net

# ----------------------------------------------------------------------------
# Kafka (кластер из 3 брокеров, KRaft). Внешние порты хоста для локального
# запуска монолит-сервиса (bootstrap.servers):
#   localhost:9092, localhost:9093, localhost:9094
# ----------------------------------------------------------------------------
KAFKA1_PORT=9092
KAFKA2_PORT=9093
KAFKA3_PORT=9094
# Входящий топик (3 партиции, replication factor 3)
KAFKA_TOPIC=pipeline.inbound

# ----------------------------------------------------------------------------
# RabbitMQ (кластер из 3 нод). Учётка приложения и Erlang cookie кластера.
# ----------------------------------------------------------------------------
RABBITMQ_USER=pipeline
RABBITMQ_PASSWORD=pipeline-secret
RABBITMQ_COOKIE=event-driven-secret-cookie
# AMQP-порты и порты management UI каждой ноды (5672/15672 — основная)
RABBIT1_PORT=5672
RABBIT1_MGMT_PORT=15672
RABBIT2_PORT=5673
RABBIT2_MGMT_PORT=15673
RABBIT3_PORT=5674
RABBIT3_MGMT_PORT=15674
# Топология: topic exchange (durable) -> queue (durable, quorum) по routing key
RABBIT_EXCHANGE=pipeline.exchange
RABBIT_QUEUE=pipeline.stage2.queue
RABBIT_ROUTING_KEY=stage.rabbit

# ----------------------------------------------------------------------------
# Redis (master + replica). Пароль, внешние порты, префикс ключей результата
# (pipeline:result:{correlationId}, TTL 60c) и канал pub/sub уведомлений.
# ----------------------------------------------------------------------------
REDIS_PASSWORD=redis-secret
REDIS_MASTER_PORT=6379
REDIS_REPLICA_PORT=6380
REDIS_RESULT_KEY_PREFIX=pipeline:result:
REDIS_COMPLETED_CHANNEL=pipeline:completed

# ----------------------------------------------------------------------------
# Java-сервис (монолит-оркестратор pipeline). HTTP-порт приложения.
# ----------------------------------------------------------------------------
APP_PORT=8080
